generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SessionStatus {
  IN_PROGRESS
  FINISHED
}

enum Role {
  USER
  OPPONENT
}

enum StageType {
  CONTACT
  DISCOVERY
  PITCH
  OBJECTION
  CLOSING
}

model Scenario {
  id              String     @id @default(cuid())
  title           String
  domain          String
  playerRole      String     @default("") // кто игрок в этом сценарии — видно на экране контекста
  situation       String     @default("") // исходная ситуация ("где я, зачем эта встреча") — видно на экране контекста
  difficulty      Difficulty @default(MEDIUM)
  successCriteria String
  isPublished     Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  levels   Level[]
  sessions Session[]
}

// Отдельная игровая задача/этап переговоров (например "Менеджер" -> "ЛПР" -> "Закрытие").
// opponentRole/opponentTone/opponentGoals/openingLine живут здесь, а не в Scenario,
// потому что на разных уровнях может быть разный персонаж NPC.
model Level {
  id               String   @id @default(cuid())
  scenarioId       String
  scenario         Scenario @relation(fields: [scenarioId], references: [id])
  order            Int
  title            String
  opponentRole     String
  opponentTone     String
  opponentGoals    String
  objective        String
  openingLine      String
  maxRounds        Int      @default(6)
  advanceThreshold Int      @default(70)
  failThreshold    Int      @default(20)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stages Stage[]

  @@unique([scenarioId, order])
  @@index([scenarioId])
}

// Подэтап внутри уровня. `type` — фиксированный каталог, на который завязаны
// детерминированные правила движка (lib/engine/rules.ts); title/description — только флавор для UI/промптов.
//
// Ветвление (lib/engine/transition.ts): несколько Stage могут делить один и тот же `order` внутри
// уровня — это развилка. У stage основного (неразветвлённого) пути branchKey = null. У пары
// стадий-вариантов на развилке branchKey = "soft" | "hard": движок детерминированно выбирает,
// какую из них показать игроку, по накопленному за уровень балансу мягких (RAPPORT/CONCESSION) и
// жёстких (PRESSURE/ARGUMENT) действий игрока (см. NegotiationState.branchSignal). Выбор
// фиксируется на весь уровень в NegotiationState.branch — сюжет не "прыгает" между вариантами.
//
// @@unique ниже — [levelId, order, branchKey], а не просто [levelId, order]: Postgres не считает
// два NULL равными в unique-индексе, так что несколько строк с одним order и branchKey=null
// технически не запрещены на уровне БД. На практике единственный источник данных — сид/админка,
// которые сами не создают такие дубликаты, поэтому это осознанно принятый компромисс, а не
// полноценный constraint (полный вариант потребовал бы partial unique index вне Prisma schema DSL).
model Stage {
  id          String    @id @default(cuid())
  levelId     String
  level       Level     @relation(fields: [levelId], references: [id])
  order       Int
  type        StageType
  title       String?
  description String?
  branchKey   String? // null = основной путь; "soft" | "hard" = вариант развилки на этом order

  @@unique([levelId, order, branchKey])
  @@index([levelId])
}

model Session {
  id         String        @id @default(cuid())
  scenarioId String
  scenario   Scenario      @relation(fields: [scenarioId], references: [id])
  status     SessionStatus @default(IN_PROGRESS)
  state      Json // NegotiationState (lib/engine/types.ts), снапшот целиком
  turns      Turn[]
  feedback   Feedback?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([scenarioId])
}

model Turn {
  id            String     @id @default(cuid())
  sessionId     String
  session       Session    @relation(fields: [sessionId], references: [id])
  role          Role
  text          String
  levelOrder    Int?
  stageOrder    Int?
  // Записывается напрямую из уже посчитанного Engine-состояния в момент создания хода
  // (lib/engine, NegotiationState.stageProgress.type / текущий Stage), а не резолвится задним
  // числом по (levelOrder, stageOrder): при ветвлении сценария несколько Stage могут делить один
  // order внутри уровня, и такой резолв по одному order стал бы неоднозначным.
  stageType     StageType?
  actionType    String?
  actionQuality Int?
  score         Int?
  scoreNotes    String?
  createdAt     DateTime   @default(now())

  @@index([sessionId])
}

model Feedback {
  id                   String   @id @default(cuid())
  sessionId            String   @unique
  session              Session  @relation(fields: [sessionId], references: [id])
  outcome              String
  summary              String
  strengths            String
  improvements         String
  overallScore         Int
  perLevelBreakdown    Json? // прогресс по номерованным Level (было)
  stageBreakdown       Json? // разбор по типу этапа (Контакт/Выявление потребности/... ), см. lib/engine/feedbackFacts.ts
  keyMomentQuote       String? // дословная реплика игрока, ставшая переломным моментом (может отсутствовать)
  keyMomentExplanation String?
  betterAnswer         String? // пример более сильной формулировки
  createdAt            DateTime @default(now())
}
