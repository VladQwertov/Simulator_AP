# Скопируйте этот файл в .env и заполните значения (.env — в .gitignore, не коммитится).

# Обязательно: строка подключения к PostgreSQL.
# Локально можно поднять через docker-compose-pg.yml: docker compose -f docker-compose-pg.yml up -d
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/simulator_ap"

# Ключ Groq API для реального LLM (классификация реплик, ответы NPC, фидбек).
# Необязателен, если MOCK_LLM=true — тогда движок работает полностью офлайн на fallback-эвристиках.
GROQ_API_KEY=""

# Модель Groq. Необязательно — по умолчанию используется openai/gpt-oss-120b.
# Список актуальных моделей для своего ключа: GET https://api.groq.com/openai/v1/models
# LLM_MODEL="openai/gpt-oss-120b"

# true — не обращаться к внешнему LLM API вообще, использовать детерминированные
# fallback-заглушки (нужны для демо без ключа/интернета и в тестах).
MOCK_LLM="false"
